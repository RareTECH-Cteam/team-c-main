# 原則として全ファイルを除外
**

# フロントエンドソースだけ許可
!frontend/
!frontend/**

# nginx設定だけ許可
!Docker/
!Docker/Frontend.Dockerfile
!Docker/Frontend.Dockerfile.dockerignore
!Docker/nginx/
!Docker/nginx/default.conf

# フロントエンド内の不要物・秘密情報を再除外
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/npm-debug.log*
frontend/.env
frontend/.env.*
frontend/*.local
frontend/.npmrc