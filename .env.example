# ================================================================
# .env.example
# 使い方:
#   cp .env.example .env
#   → 各項目に実値を書き込む
# ================================================================

# --- Django 実行モード ---
# デバッグモード (本番は必ず False)
DEBUG=True
# 生成方法:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 注意：生成時、$があり１つの場合、変数扱いされるので$$でエスケープ必須
DJANGO_SECRET_KEY=django-insecure-09o+f1qdkm=x1*ksyy28em&b_yy38gk-p394=k4psdy_a5i83l
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,nginx,api
LOG_LEVEL=DEBUG
ENV=local

# --- PostgreSQL ---
DB_PASSWORD=localpass

# --- AWS プロファイル ---
AWS_PROFILE=default

# --- メール (local) ---
# SES資格情報はデプロイ時に本番環境から注入するため、ここには記載しない。
DEFAULT_FROM_EMAIL=noreply@kotobuddy.jp

# --- 外部 API ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
STRIPE_API_KEY=
